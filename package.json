{
	"name": "opportunity-monorepo",
	"type": "module",
	"version": "2.3.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Monorepo for Opportunity project",
	"author": "Jacob Anderson",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"build": "npm run -w front-end build && npm run -w back-end build",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"serve": "npm run -w front-end serve",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"format:check": "prettier --check \"front-end/src/**/*.{js,ts,vue}\" \"!front-end/src/**/*.d.ts\" \"back-end/src/**/*.{js,ts}\" \"!back-end/src/**/*.d.ts\" \"scripts/**/*.mjs\"",
		"format:write": "prettier --write \"front-end/src/**/*.{js,ts,vue}\" \"!front-end/src/**/*.d.ts\" \"back-end/src/**/*.{js,ts}\" \"!back-end/src/**/*.d.ts\" \"scripts/**/*.mjs\"",
		"lint": "npm run format:check && npm run -w front-end lint && npm run -w back-end lint",
		"lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"clean": "node scripts/clean-build.mjs dist front-end/dist back-end/dist back-end/dist-test",
		"up": "taze major -I && npm run -w front-end up && npm run -w back-end up",
		"a11y": "node scripts/a11y-smoke.mjs",
		"test": "npm run -w front-end test:unit && npm run -w back-end test",
		"audit": "npm audit --audit-level=high",
		"audit:production": "npm audit --omit=dev --audit-level=high",
		"audit:signatures": "npm audit signatures",
		"verify:api-production-install": "node scripts/verify-api-production-install.mjs",
		"verify:build-security": "node scripts/verify-build-security.mjs",
		"verify:public": "node scripts/verify-public.mjs",
		"verify:config": "npm run -w back-end verify:config",
		"verify:deploy": "npm run audit && npm run audit:production && npm run audit:signatures && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:build-security && npm run verify:api-production-install"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@unocss/eslint-plugin": "^66.6.7",
		"axe-core": "^4.11.4",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.9.0",
		"js-beautify": "2.0.3",
		"prettier": "^3.8.3",
		"puppeteer": "^25.4.0",
		"taze": "^19.11.0",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"argon2@0.45.1": true,
		"cypress@15.19.0": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": true,
		"vue-demi@0.14.10": true
	},
	"overrides": {
		"defu": "6.1.6",
		"vite": "^8.1.0",
		"oxc-parser": "0.142.0",
		"vue-router": "^5.0.4",
		"follow-redirects": "1.16.0",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.15.2"
		},
		"brace-expansion": "5.0.8",
		"fast-uri": "3.1.4",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"shell-quote": "1.10.0",
		"svgo": "4.0.2",
		"tar": "7.5.22",
		"valibot": "1.4.2",
		"js-beautify": "2.0.3"
	}
}
