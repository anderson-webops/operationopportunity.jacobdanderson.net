NODE_ENV=development
HOST=127.0.0.1
PORT=3002
PUBLIC_ORIGIN=http://localhost:3333
TRUSTED_PROXY_IPS=

# Generate at least 32 random characters. Use SESSION_SECRETS_JSON for rotation.
SESSION_SECRET=replace-with-at-least-32-random-characters
# SESSION_SECRETS_JSON=["newest-secret","previous-secret"]

# Development may use an unauthenticated loopback Mongo only with this explicit exception.
MONGODB_URI=mongodb://127.0.0.1:27017/opportunity
ALLOW_UNAUTHENTICATED_MONGO_LOOPBACK=true

# Optional Vault integration. Configure both credentials or neither.
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_ROLE_ID=replace-role-id
# VAULT_SECRET_ID=replace-secret-id
# VAULT_MONGO_SECRET_PATH=secret/data/opportunity/mongodb

QUOTES_UPSTREAM_SOCKET_PATH=/run/quotes/quotes.sock
QUOTES_UPSTREAM_URL=https://jacobdanderson.net/quotes-api

ENABLE_INTERNAL_DIAGNOSTICS=false
# INTERNAL_DIAGNOSTICS_KEY=replace-with-at-least-32-random-characters
