{
	"name": "back-end",
	"version": "2.3.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch --env-file-if-exists=.env src/server.ts",
		"server:once": "tsx --env-file-if-exists=.env src/server.ts",
		"test": "node ../scripts/clean-build.mjs back-end/dist-test && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
		"start": "node dist/server.js",
		"build": "node ../scripts/clean-build.mjs back-end/dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"up": "taze major -I",
		"lint": "eslint \"src/**/*.{js,ts}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" --fix",
		"create-admin": "tsx --env-file-if-exists=.env src/create-admin-user.ts",
		"recover-admin-manager": "tsx --env-file-if-exists=.env src/grant-admin-manager.ts",
		"reset-account-password": "tsx --env-file-if-exists=.env src/reset-account-password.ts",
		"verify:config": "tsx src/scripts/verifyConfig.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"argon2": "^0.45.1",
		"connect-mongo": "^6.0.0",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.1",
		"express-session": "^1.19.0",
		"helmet": "^8.1.0",
		"mongoose": "^9.3.3",
		"readline-sync": "^1.4.10"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^24.13.3",
		"@types/readline-sync": "^1.4.8",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"overrides": {
		"lodash": "4.18.1",
		"body-parser": "$body-parser",
		"brace-expansion": "5.0.9",
		"esbuild": "0.28.1",
		"js-yaml": "4.3.1",
		"postcss": "8.5.26",
		"qs": "6.15.3",
		"vite": "8.2.0"
	}
}
