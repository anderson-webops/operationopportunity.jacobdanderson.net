{
	"name": "back-end",
	"version": "2.3.6",
	"private": true,
	"packageManager": "npm@12.2.1",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.1 <13"
	},
	"description": "",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch --env-file-if-exists=.env src/server.ts",
		"server:once": "tsx --env-file-if-exists=.env src/server.ts",
		"test": "node ../scripts/clean-build.mjs back-end/dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
		"start": "node dist/server.js",
		"build": "node ../scripts/clean-build.mjs back-end/dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"up": "taze major -I",
		"lint": "eslint \"src/**/*.{js,ts}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" --fix",
		"create-admin": "node dist/create-admin-user.js",
		"recover-admin-manager": "node dist/grant-admin-manager.js",
		"reset-account-password": "node dist/reset-account-password.js",
		"verify:config": "node dist/scripts/verifyConfig.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"argon2": "^0.45.1",
		"connect-mongo": "^6.0.0",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.1",
		"express-session": "^1.19.0",
		"helmet": "^8.1.0",
		"mongoose": "^9.3.3",
		"readline-sync": "^1.4.10"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^26.6.6",
		"@types/readline-sync": "^1.4.8",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"overrides": {
		"lodash": "4.18.1",
		"body-parser": "$body-parser",
		"brace-expansion": "5.0.12",
		"esbuild": "0.28.1",
		"js-yaml": "4.3.2",
		"postcss": "8.5.26",
		"qs": "6.17.1",
		"vite": "8.3.5"
	}
}
