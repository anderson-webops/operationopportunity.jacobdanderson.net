NODE_ENV=production
HOST=127.0.0.1
PORT=3002
PUBLIC_ORIGIN=https://operationopportunity.jacobdanderson.net
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Start with one CSPRNG-generated secret. For rotation, replace this line with:
# SESSION_SECRETS_JSON='["newest-secret","previous-secret"]'
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_MS=86400000
SESSION_REMEMBER_MAX_AGE_MS=2592000000

# Configure exactly one Mongo secret source. Authenticated Mongo is required in production.
MONGODB_URI=mongodb://operation_app:replace-password@127.0.0.1:27017/opportunity?authSource=opportunity
# VAULT_ADDR=https://vault.internal.example
# VAULT_ROLE_ID=replace-role-id
# VAULT_SECRET_ID=replace-secret-id
# VAULT_MONGO_SECRET_PATH=secret/data/opportunity/mongodb

QUOTES_UPSTREAM_SOCKET_PATH=/run/quotes/quotes.sock
QUOTES_UPSTREAM_URL=https://jacobdanderson.net/quotes-api

ENABLE_INTERNAL_DIAGNOSTICS=false
# INTERNAL_DIAGNOSTICS_KEY=replace-with-at-least-32-random-characters

OPPORTUNITY_COMMIT_SHA=replace-with-deployed-git-sha
OPPORTUNITY_DEPLOYED_AT=2026-07-29T00:00:00Z
